# Required in production
AUTH_SECRET=generate-a-long-random-string-here

# Server
# Host port Docker binds on localhost (Caddy proxies public :80 → this). Do not set to 80.
APP_PORT=3000
NODE_ENV=production

# SQLite path (default: ./data/historycodex.db)
# DATABASE_PATH=/var/lib/historycodex/historycodex.db

# true when users access the site over HTTPS; false for plain HTTP (e.g. Tailscale/LAN)
AUTH_COOKIE_SECURE=true

# Optional: Google Books search in admin book picker
# GOOGLE_BOOKS_API_KEY=

# Optional feature flag
# READING_SESSIONS_REQUIRED=false

# Dev only: comma-separated LAN origins for next dev
# DEV_ALLOWED_ORIGINS=http://192.168.1.43:3000
