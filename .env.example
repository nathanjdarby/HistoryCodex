# Required in production
AUTH_SECRET=generate-a-long-random-string-here

# Server
APP_PORT=3000
NODE_ENV=production

# Supabase Postgres — app runtime (pooler, transaction mode)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Migrations only — session pooler (port 5432) works from Docker; direct db.* host may be IPv6-only
DATABASE_URL_DIRECT=postgresql://postgres.[ref]:[password]@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# Supabase Storage — shared uploads for cards, packs, and book covers
# Project URL (optional if DATABASE_URL uses postgres.[ref]@...)
# SUPABASE_URL=https://[ref].supabase.co
# Service role key from Supabase → Settings → API (server-side uploads only; never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=historycodex-uploads

# One-time SQLite import source (local file path only)
# DATABASE_PATH=./data/historycodex.db

# true when users access the site over HTTPS; false for plain HTTP (e.g. Tailscale/LAN)
AUTH_COOKIE_SECURE=true

# Optional: Google Books search in admin book picker
# GOOGLE_BOOKS_API_KEY=

# Optional feature flag
# READING_SESSIONS_REQUIRED=false

# Dev only: comma-separated LAN origins for next dev
# DEV_ALLOWED_ORIGINS=http://192.168.1.43:3000

# Dev only: when local dev shares Supabase with production, fetch missing upload files
# from the live server and cache them under public/uploads/ before running uploads:migrate
# UPLOAD_MIRROR_URL=https://your-production-host
